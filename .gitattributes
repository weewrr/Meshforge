# 跨平台 EOL 规范化
# 仓库在 Windows 上开发、在 Linux CI 上验证，必须固定换行符，
# 否则 CRLF/LF 差异会造成无意义的整文件 diff 与 shell 脚本执行失败。

# 默认：检出时交给平台，入库统一 LF
* text=auto eol=lf

# Windows 专属脚本必须保留 CRLF，否则 cmd.exe 解析异常
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# shell 脚本必须是 LF，否则 Linux CI 报 bad interpreter
*.sh text eol=lf

# 二进制文件不做任何转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
*.zip binary
*.7z binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.node binary
*.pyc binary
*.pak binary
*.db binary

# 语言统计：把生成物与锁文件排除出 linguist
package-lock.json linguist-generated=true -diff
dist/** linguist-generated=true
out/** linguist-generated=true
