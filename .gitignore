electron.vite.config.*.mjs


# 本地记忆与临时文件(不上传)
.workbuddy/
.ui-check/

# ─── 开发过程痕迹（本地留存，不入库）─────────────────────────────────────────

# 开发过程文档：优化计划 / 代码审查 / 注释报告 / 蓝图。
