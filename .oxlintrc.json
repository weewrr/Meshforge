{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "react-hooks", "unicorn"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react/set-state-in-effect": "off",
    "react/preserve-manual-memoization": "off"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "globals": {
    "React": "readonly"
  },
  "ignorePatterns": [
    "out/**",
    "dist/**",
    "node_modules/**",
    "server/.venv/**"
  ]
}
