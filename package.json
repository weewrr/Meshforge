{
  "name": "meshforge",
  "version": "0.1.0",
  "description": "Local, open-source image-to-3D mesh generation for consumer GPUs",
  "license": "MIT",
  "author": "weewrr",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "pack": "electron-builder --dir",
    "dist": "electron-vite build && electron-builder",
    "test": "npm run test:paths && npm run test:modeldl && npm run test:mvparams && npm run test:genparams && npm run test:imgparams && npm run test:extstate && npm run test:stdio && npm run test:pipeline && npm run test:web && npm run test:nodes && npm run test:ui && npm run test:toolbar",
    "test:paths": "server\\.venv\\Scripts\\python.exe server/tests/test_paths.py",
    "test:modeldl": "server\\.venv\\Scripts\\python.exe server/tests/test_model_downloads.py",
    "test:modeldl:live": "server\\.venv\\Scripts\\python.exe scripts/test_model_download_live.py",
    "test:mvparams": "server\\.venv\\Scripts\\python.exe server/tests/test_multiview_params.py",
    "test:genparams": "server\\.venv\\Scripts\\python.exe server/tests/test_generator_node_params.py",
    "test:imgparams": "server\\.venv\\Scripts\\python.exe server/tests/test_image_node_params.py",
    "test:extstate": "server\\.venv\\Scripts\\python.exe server/tests/test_disabled_extensions.py",
    "test:jobs": "server\\.venv\\Scripts\\python.exe server/tests/test_jobs.py",
    "test:workflows": "server\\.venv\\Scripts\\python.exe server/tests/test_workflows.py",
    "test:web": "node scripts/test_web.mjs",
    "test:nodes": "node scripts/test_nodes.mjs",
    "test:ui": "node scripts/test_node_ui.mjs",
    "test:toolbar": "node scripts/test_toolbar_layout.mjs",
    "test:stdio": "server\\.venv\\Scripts\\python.exe scripts/test_mcp_stdio.py",
    "test:pipeline": "server\\.venv\\Scripts\\python.exe scripts/test_model_pipeline.py",
    "test:generate": "server\\.venv\\Scripts\\python.exe scripts/test_mcp_generate.py",
    "openapi": "server\\.venv\\Scripts\\python.exe scripts/export_openapi.py",
    "openapi:check": "server\\.venv\\Scripts\\python.exe scripts/export_openapi.py --check",
    "sizes": "node scripts/check_bundle_budget.mjs",
    "lint": "oxlint src electron scripts",
    "lint:fix": "oxlint --fix src electron scripts",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@xyflow/react": "^12.11.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "oxlint": "^1.83.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  }
}
